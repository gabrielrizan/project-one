[gd_scene format=3 uid="uid://b0l028hou24kb"]

[sub_resource type="GDScript" id="GDScript_oyde6"]
script/source = "extends Node3D

@onready var camera: Camera3D = $PlayerCamera
@onready var paper: AnimatableBody3D = $Parchment
@onready var stamp_zone: Area3D = $Parchment/StampZone

var grabbed_object: Node3D = null
var lift_height: float = 0.2
var current_mouse_pos: Vector2 = Vector2.ZERO

func _unhandled_input(event: InputEvent) -> void:
	if event is InputEventMouseMotion: current_mouse_pos = event.position
	if event is InputEventMouseButton and event.button_index == MOUSE_BUTTON_LEFT:
		if event.is_pressed(): try_grab(event.position)
		else: release_grab()

func _physics_process(delta: float) -> void:
	if grabbed_object: drag_object(current_mouse_pos, delta)

func try_grab(mouse_pos: Vector2) -> void:
	var result = shoot_ray(mouse_pos, 1) # Layer 1
	if result:
		grabbed_object = result.collider
		grabbed_object.position.y += lift_height
		print(\"Grabbed: \", grabbed_object.name)

func drag_object(mouse_pos: Vector2, delta: float) -> void:
	var result = shoot_ray(mouse_pos, 2) # Layer 2 (Desk)
	if result:
		var target = Vector3(result.position.x, grabbed_object.global_position.y, result.position.z)
		grabbed_object.global_position = grabbed_object.global_position.lerp(target, 15.0 * delta)

func release_grab() -> void:
	if grabbed_object:
		# CHECK: Did we drop the stamp on the paper?
		if grabbed_object.name == \"IronStamp\":
			var overlapping = stamp_zone.get_overlapping_bodies()
			if grabbed_object in overlapping:
				print(\"STAMPED! Result: APPROVED\")
				# Here you would trigger an animation/decal
		
		grabbed_object.position.y -= lift_height
		grabbed_object = null

func shoot_ray(mouse_pos: Vector2, mask: int) -> Dictionary:
	var from = camera.project_ray_origin(mouse_pos)
	var to = from + camera.project_ray_normal(mouse_pos) * 100.0
	var space = get_world_3d().direct_space_state
	return space.intersect_ray(PhysicsRayQueryParameters3D.create(from, to, mask))
"

